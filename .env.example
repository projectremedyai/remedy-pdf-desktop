# ──────────────────────────────────────────────────────────
# Remedy PDF Desktop — Native App Environment
# ──────────────────────────────────────────────────────────
# The native desktop app defaults to local inference. No API keys required
# unless a user chooses Ollama Cloud, OpenAI, or Anthropic in Model Settings.
# Copy to .env only if you need to override a default below.

# ── Security (optional, for browser/API access) ─────────
# APP_ENV=development
#
# When set, all /api/* and /ws/* requests must send X-API-Key. Leave
# empty to disable auth (local desktop usage).
# APP_API_KEY=
#
# If APP_API_KEY is enabled for the bundled web UI, build the frontend with
# the same value as VITE_APP_API_KEY so browser requests can authenticate.
# VITE_APP_API_KEY=

# Upload rate limit (requests per minute per IP). Default 10.
# UPLOAD_RATE_LIMIT=10

# CORS allowed origins (comma-separated).
# CORS_ORIGINS=http://localhost:1420,http://localhost:5173

# ── File Storage ────────────────────────────────────────
# UPLOAD_DIR=./data/uploads
# OUTPUT_DIR=./data/output

# Max upload size in bytes (default 50 MB).
# MAX_UPLOAD_BYTES=52428800

# Job TTL in seconds (default 7200 = 2 hours). Completed/failed jobs
# older than this are purged automatically.
# JOB_TTL_SECONDS=7200

# ── Processing Limits ───────────────────────────────────
# MAX_CONCURRENT_JOBS=5
# MAX_PAGES=50
# VISUAL_DIFF_REVIEW_THRESHOLD=0.10
# VISUAL_ARTIFACT_CHECK_PAGES=0      # 0 = auto-scale; positive = pin exact page count
# VISUAL_ARTIFACT_CHECK_MAX_PAGES=20  # Upper bound used by auto-scale + deterministic mode

# ── Readability score weights (must sum to whatever total you want) ────
# READABILITY_W_TEXT=30
# READABILITY_W_TAG=25
# READABILITY_W_ALT=20
# READABILITY_W_HEADING=15
# READABILITY_W_TABLE_LIST=10

# ── Backend sidecar (read by Tauri Rust shell) ──────────
# PROJECT_REMEDY_BACKEND_CMD=uvicorn
# PROJECT_REMEDY_BACKEND_HOST=127.0.0.1
# PROJECT_REMEDY_BACKEND_PORT=8000
# PROJECT_REMEDY_OLLAMA_CMD=ollama

# ── Local Ollama runtime ────────────────────────────────
# OLLAMA_BASE_URL=http://127.0.0.1:11500/v1
# OLLAMA_VISION_MODEL=gemma4:e4b
# OLLAMA_TEXT_MODEL=gemma4:e4b
# OLLAMA_MODELS=~/.project-remedy/ollama/models
#
# Optional OpenAI-compatible per-task router aliases. Unknown prompts still
# use OLLAMA_VISION_MODEL. When set, the backend verifies each alias is listed
# by /api/tags before enabling the local vision provider.
#
# MiniCPM router launch policy lives on the router process, not in the desktop
# backend env. Current policy: table=4x:36; everything else (including
# reading_order v4, trained and validated at 16x:1) uses the router default 16x:1.
# Example router flag:
#   --adapter-image-settings "table=4x:36"
# OLLAMA_VISION_TASK_MODELS=contrast:minicpm-v46-remedy-contrast-v1,reading_order:minicpm-v46-remedy-reading-order-v4,heading_hierarchy:minicpm-v46-remedy-heading-v1,table_structure:minicpm-v46-remedy-table-v1,alt_text_quality:minicpm-v46-remedy-alt-v1
# OLLAMA_VISION_TASK_BASE_URLS=
# OLLAMA_VISION_ROUTER_ALLOW_FALLBACK=0
# OLLAMA_VISION_MAX_INFLIGHT=1
# OLLAMA_VISION_GATE_TIMEOUT_SECONDS=600
# OLLAMA_VISION_MAX_TOKENS=1024

# ── Optional vision-provider defaults ───────────────────
# These only seed the first Model Settings value. Saved settings live in
# data/vision_settings.json during development or the app support directory
# in a packaged desktop install.
# VISION_PROVIDER=local
# OPENROUTER_API_KEY=
# OPENROUTER_VISION_MODEL=openai/gpt-4o-mini
# OLLAMA_API_KEY=
# OLLAMA_CLOUD_VISION_MODEL=qwen3-vl:235b-cloud
# PDF_FIXER_VISION_PAGE_TIMEOUT=90
