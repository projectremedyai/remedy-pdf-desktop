# OS
.DS_Store
default.profraw
excalidraw.log

# Build artifacts
dist/
build/
*.spec~
src-tauri/target/

# Bundled native runtimes (downloaded at build time, not stored in git)
/resources/ollama/macos/*
!/resources/ollama/macos/README.md
/resources/ollama/windows/*
!/resources/ollama/windows/PLACE_OLLAMA_HERE.txt
# Stray Vite code-split chunks if they land at repo root (should live under web/dist/)
/product-name-*.js
/*-*.js

# Local debug notes — keep locally, don't track
APP_DEBUG_NOTES_*.md
*johnnyrobot*Mac Studio*

# Duplicate agent-instruction files (content lives in CLAUDE.md)
/AGENTS.md

# Agent/tool local state
/entities.json
/mempalace.yaml
/openmemory.md
/.claude/
/.cursor/
/.playwright-mcp/

# Clean seed repo exclusions
*.md
docs/
doc/
knowledge-base/
knowledge_base/
*knowledge-base*/
tests/
test/
__tests__/
test_*.py
*_test.py
*.test.*
*.spec.*
!README.md
!/tools/minicpm_edge/*.md

# CI smoke tests are part of this repo.
!tests/
!tests/**/
!tests/**/*.py

# Screenshots / demo recordings — not part of source
screenshots/
