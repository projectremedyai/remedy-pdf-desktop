[Unit]
Description=Remedy PDF Desktop
After=network.target

[Service]
Type=simple
User=remedy
Group=remedy
WorkingDirectory=/opt/remedy-pdf-desktop
EnvironmentFile=/opt/remedy-pdf-desktop/.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/remedy-pdf-desktop/.venv/bin/uvicorn backend.app.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=30

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/remedy-pdf-desktop/data

[Install]
WantedBy=multi-user.target
